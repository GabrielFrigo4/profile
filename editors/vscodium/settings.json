{
	// ==========================================
	// INTERFACE
	// ==========================================
	"window.autoDetectColorScheme": true,

	// ==========================================
	// APARÊNCIA
	// ==========================================
	"editor.fontFamily": "'JetBrainsMono Nerd Font Mono'",
	"editor.fontLigatures": true,
	"editor.fontSize": 16,
	"editor.wordWrap": "off",
	"diffEditor.wordWrap": "off",
	"notebook.output.wordWrap": true,
	"diffEditor.ignoreTrimWhitespace": false,

	// ==========================================
	// CORE
	// ==========================================
	"editor.formatOnSave": true,
	"editor.formatOnType": true,
	"editor.tabCompletion": "on",
	"editor.insertSpaces": false,
	"editor.inlineSuggest.enabled": false,
	"files.autoGuessEncoding": true,
	"security.workspace.trust.untrustedFiles": "open",

	// ==========================================
	// EXPLORER
	// ==========================================
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,

	// ==========================================
	// GIT
	// ==========================================
	"git.openRepositoryInParentFolders": "never",
	"git.enableSmartCommit": true,
	"git.confirmSync": false,

	// ==========================================
	// DEFAULTS
	// ==========================================
	"terminal.integrated.defaultProfile.windows": "pwsh",
	"terminal.integrated.defaultProfile.linux": "zsh",
	"terminal.integrated.defaultProfile.osx": "zsh",

	// ==========================================
	// WINDOWS
	// ==========================================
	"terminal.integrated.profiles.windows": {
		"PowerShell": {
			"path": "powershell.exe",
		},
		"Nushell": {
			"path": "nu.exe",
		},
		"pwsh": {
			"path": "pwsh.exe",
		},
		"cmd": {
			"path": "cmd.exe",
		},
		"MSYS2 UCRT64": {
			"path": "C:\\msys64\\msys2_shell.cmd",
			"args": ["-defterm", "-here", "-no-start", "-ucrt64", "-shell", "zsh"],
		},
		"MSYS2 CLANG64": {
			"path": "C:\\msys64\\msys2_shell.cmd",
			"args": ["-defterm", "-here", "-no-start", "-clang64", "-shell", "zsh"],
		},
		"MSYS2 CLANGARM64": {
			"path": "C:\\msys64\\msys2_shell.cmd",
			"args": ["-defterm", "-here", "-no-start", "-clangarm64", "-shell", "zsh"],
		},
		"MSYS2 MINGW64": {
			"path": "C:\\msys64\\msys2_shell.cmd",
			"args": ["-defterm", "-here", "-no-start", "-mingw64", "-shell", "zsh"],
		},
		"MSYS2 MSYS": {
			"path": "C:\\msys64\\msys2_shell.cmd",
			"args": ["-defterm", "-here", "-no-start", "-msys", "-shell", "zsh"],
		},
	},

	// ==========================================
	// LINUX & BSD
	// ==========================================
	"terminal.integrated.profiles.linux": {
		"zsh": {
			"path": "zsh",
			"args": ["-l"],
		},
		"bash": {
			"path": "bash",
			"args": ["-l"],
		},
		"sh": {
			"path": "sh",
			"args": ["-l"],
		},
	},

	// ==========================================
	// SINTAXE
	// ==========================================
	"files.associations": {
		"*.shader": "hlsl",
		"*.arm": "arm",
		"*.asm": "nasm",
		"*.wlua": "lua",
	},
}
