{
	// ==========================================
	// INTERFACE
	// ==========================================
	"workbench.preferredDarkColorTheme": "One Dark Pro Darker",
	"workbench.colorTheme": "One Dark Pro Darker",
	"workbench.iconTheme": "material-icon-theme",
	"window.autoDetectColorScheme": true,

	// ==========================================
	// APPEARANCE
	// ==========================================
	"editor.fontFamily": "'JetBrainsMono Nerd Font'",
	"editor.fontLigatures": true,
	"editor.wordWrap": "off",
	"editor.fontSize": 16,
	"diffEditor.ignoreTrimWhitespace": false,
	"diffEditor.wordWrap": "off",
	"notebook.output.wordWrap": true,

	// ==========================================
	// EDITOR
	// ==========================================
	"security.workspace.trust.untrustedFiles": "open",
	"editor.formatOnSave": true,
	"editor.tabCompletion": "on",
	"editor.insertSpaces": false,
	"files.autoGuessEncoding": true,
	"files.watcherExclude": {
		"**/*": true
	},

	// ==========================================
	// EXPLORER
	// ==========================================
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	"explorer.confirmPasteNative": false,

	// ==========================================
	// GIT
	// ==========================================
	"git.openRepositoryInParentFolders": "never",
	"git.replaceTagsWhenPull": true,
	"git.enableSmartCommit": true,
	"git.confirmSync": false,

	// ==========================================
	// TERMINAL
	// ==========================================
	"terminal.integrated.defaultProfile.windows": "pwsh",
	"terminal.integrated.defaultProfile.linux": "zsh",
	"terminal.integrated.defaultProfile.osx": "zsh",

	// ==========================================
	// WINDOWS
	// ==========================================
	"terminal.integrated.profiles.windows": {
		"PowerShell": {
			"path": "powershell.exe"
		},
		"Nushell": {
			"path": "nu.exe"
		},
		"pwsh": {
			"path": "pwsh.exe"
		},
		"cmd": {
			"path": "cmd.exe"
		},
		"MSYS2 UCRT64": {
			"path": "C:\\msys64\\msys2_shell.cmd",
			"args": ["-defterm", "-here", "-no-start", "-ucrt64", "-shell", "zsh"]
		},
		"MSYS2 CLANG64": {
			"path": "C:\\msys64\\msys2_shell.cmd",
			"args": ["-defterm", "-here", "-no-start", "-clang64", "-shell", "zsh"]
		},
		"MSYS2 CLANGARM64": {
			"path": "C:\\msys64\\msys2_shell.cmd",
			"args": ["-defterm", "-here", "-no-start", "-clangarm64", "-shell", "zsh"]
		},
		"MSYS2 MINGW64": {
			"path": "C:\\msys64\\msys2_shell.cmd",
			"args": ["-defterm", "-here", "-no-start", "-mingw64", "-shell", "zsh"]
		},
		"MSYS2 MSYS": {
			"path": "C:\\msys64\\msys2_shell.cmd",
			"args": ["-defterm", "-here", "-no-start", "-msys", "-shell", "zsh"]
		}
	},

	// ==========================================
	// LINUX AND BSD
	// ==========================================
	"terminal.integrated.profiles.linux": {
		"zsh": {
			"path": "zsh",
			"args": ["-l"]
		},
		"bash": {
			"path": "bash",
			"args": ["-l"]
		},
		"sh": {
			"path": "sh",
			"args": ["-l"]
		}
	},

	// ==========================================
	// ASSOCIATIONS
	// ==========================================
	"files.associations": {
		// ------------------------------------------
		// LANGUAGES
		// ------------------------------------------
		"*.wlua": "lua",

		// ------------------------------------------
		// ASSEMBLY
		// ------------------------------------------
		"*.arm": "arm",
		"*.asm": "nasm",

		// ------------------------------------------
		// GLSL - VERTEX
		// ------------------------------------------
		"*.vert": "glsl",
		"*.vs": "glsl",
		"*.vsh": "glsl",

		// ------------------------------------------
		// GLSL - FRAGMENT
		// ------------------------------------------
		"*.frag": "glsl",
		"*.fs": "glsl",
		"*.fsh": "glsl",

		// ------------------------------------------
		// GLSL - GEOMETRY
		// ------------------------------------------
		"*.geom": "glsl",
		"*.gs": "glsl",
		"*.gsh": "glsl",

		// ------------------------------------------
		// GLSL - COMPUTE
		// ------------------------------------------
		"*.comp": "glsl",
		"*.compute": "glsl",

		// ------------------------------------------
		// GLSL - TESSELLATION
		// ------------------------------------------
		"*.tesc": "glsl",
		"*.tcs": "glsl",
		"*.tese": "glsl",
		"*.tes": "glsl",

		// ------------------------------------------
		// GLSL - SHADER
		// ------------------------------------------
		"*.glsl": "glsl",
		"*.glslh": "glsl",

		// ------------------------------------------
		// HLSL - SHADER
		// ------------------------------------------
		"*.hlsl": "hlsl",
		"*.hlsli": "hlsl",
		"*.fx": "hlsl",
		"*.shader": "hlsl",

		// ------------------------------------------
		// SLANG - SHADER
		// ------------------------------------------
		"*.slang": "slang",
		"*.slangh": "slang"
	},

	// ==========================================
	// DEFAULT FORMATTER
	// ==========================================
	"editor.formatOnType": true,
	"editor.defaultFormatter": "esbenp.prettier-vscode",

	// ==========================================
	// LANGUAGE FORMATTER
	// ==========================================
	"[c]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd" },
	"[cpp]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd" },
	"[go]": { "editor.defaultFormatter": "golang.go" },
	"[python]": {
		"editor.defaultFormatter": "charliermarsh.ruff",
		"editor.insertSpaces": true,
		"editor.tabSize": 4,
		"editor.codeActionsOnSave": {
			"source.organizeImports": "explicit",
			"source.fixAll": "explicit"
		}
	},
	"[lua]": { "editor.defaultFormatter": "sumneko.lua" },
	"[xml]": { "editor.defaultFormatter": "redhat.vscode-xml" },
	"[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[dockerfile]": { "editor.defaultFormatter": "ms-azuretools.vscode-containers" },
	"[glsl]": { "editor.defaultFormatter": "xaver.clang-format" },
	"[hlsl]": { "editor.defaultFormatter": "xaver.clang-format" },
	"[slang]": { "editor.defaultFormatter": "xaver.clang-format" },

	// ==========================================
	// PYTHON ENVIRONMENT
	// ==========================================
	"python.terminal.activateEnvironment": false,
	"python.analysis.typeCheckingMode": "basic",
	"python.languageServer": "None",

	// ==========================================
	// LANGUAGE SERVER
	// ==========================================
	"ruff.lint.enable": true,
	"ruff.enable": true,

	// ==========================================
	// VALIDATOR
	// ==========================================
	"shader-validator.glsl.enabled": true,
	"shader-validator.hlsl.enabled": true,
	"shader-validator.symbolDiagnostics": false,
	"shader-studio.languageServers.slang.enabled": false,
	"shader-studio.languageServers.wgsl.enabled": false,
	"shader-studio.languageServers.glsl.enabled": false,

	// ==========================================
	// TOOLS
	// ==========================================
	"redhat.telemetry.enabled": false,

	// ==========================================
	// IA
	// ==========================================
	"editor.inlineSuggest.enabled": false,

	// ==========================================
	// ANTIGRAVITY (OPEN VSX MARKETPLACE)
	// ==========================================
	"antigravity.marketplaceGalleryItemURL": "https://open-vsx.org/extension",
	"antigravity.marketplaceExtensionGalleryServiceURL": "https://open-vsx.org/vscode/gallery"
}
